__pycache__/
*.pyc
database/*.db
# Local SQLite files anywhere in the repo (preview.db is created by the
# local preview server).
*.db
output/*.csv
output/*.xlsx
charts/*.png
.pytest_cache/
procurehub.dump
# Web app (backend/frontend)
uploads/
frontend/node_modules/
frontend/dist/

# Never commit real environment files, only *.env.example templates.
.env
*.env
!*.env.example

# Google OAuth client secret + local token helper output -- never commit
oauth_client.json

# SSH / EC2 private keys. These should never be inside the project folder at
# all, but a stray copy must never become a commit.
*.pem
*.key
*.ppk

# Database dumps -- procurehub.dump holds real business data.
*.dump
*.sql.gz

# Backups of config files -- '*.env' does not match '.env.bak', so a stray
# backup of a secrets file would otherwise be committable.
*.bak

# Dealer Portal vendor credentials (never commit; the .example is the template)
backend/dp_accounts.json
dp_accounts.json
