# =====================================================================
#  ProcureHub — NEW / CHANGED settings              (prepared 4 Sep 2026)
# =====================================================================
#
#  HOW TO USE THIS FILE
#  --------------------
#  Your backend/.env already has 77 keys set correctly (WhatsApp tokens,
#  Gmail OAuth, DATABASE_URL, company details, AI keys). DO NOT touch
#  those. This file contains ONLY what is new or has changed.
#
#      cat backend/.env.additions >> backend/.env
#
#  Then fill in the few <ANGLE BRACKET> placeholders and restart.
#  Anything already at the value you want can simply be left as-is.
#
#  Values are filled in wherever I could establish them. Where I could
#  not, the line is commented out with a note saying exactly what is
#  still needed — so nothing here can silently do the wrong thing.
#
#  ---------------------------------------------------------------------
#  WHAT IS *NOT* IN THIS FILE, ON PURPOSE
#  ---------------------------------------------------------------------
#  * The 10 sales team numbers. They are registered over WhatsApp, not
#    env: text "register sales" from the admin number, then paste the
#    Employee Name / OFFICIAL PHONE NO list. They live in the database.
#  * Customer numbers — same, "register customer".
#  * Purchase team — same, "register team".
#  * Dealer Portal dealer IDs. DP reads the dealer from the login token;
#    a dealer_id is never sent. Only usernames/passwords go here.
#  * Passwords for DP vendor accounts — I never saw them and never
#    should. Paste them yourself.


# =====================================================================
#  1. ALLOCATION — current stock only          [NEW, already ON in code]
# =====================================================================
# Your rule (3 Sep): "Allocation should only be done by the current
# stock." A vendor who last uploaded five days ago is no longer
# allocated from.
#
#   after 09:15 IST  -> only files uploaded since IST midnight today
#   before 09:15 IST -> yesterday's files still count, exactly as the
#                       Google Sheet still shows yesterday's tabs
#
# The 09:15 boundary is READ FROM GOOGLE_SHEETS_DAILY_RESET_TIME below,
# so allocation and the Sheet can never drift apart. Allocation still
# reads stock from the DATABASE — only the freshness rule is shared.
#
# false = old behaviour (every vendor's latest file counts, however
# old). Escape hatch for a day when nobody has uploaded and an order
# must still go out.
ALLOCATION_CURRENT_STOCK_ONLY=true

# The shared boundary. Change it here and allocation follows automatically.
GOOGLE_SHEETS_DAILY_RESET_TIME=09:15


# =====================================================================
#  2. PURCHASE OUTPUT — one Excel, one sheet per vendor          [NEW]
# =====================================================================
# After an allocation batch: ONE workbook whose tabs are named after the
# vendors, then Summary, then Shortages. Replaces the one-text-message-
# per-vendor output.
#
# Each vendor tab: Part Number | Vendor Part Number | Customer Requested
#                  | Vendor Available | Allocated Qty | Status | Order
#
# Internal only — founder/admin numbers + the registered purchase team.
# Never a vendor. false restores the per-vendor text messages (which are
# also the automatic fallback if the workbook cannot be built or sent).
WHATSAPP_VENDOR_WORKBOOK=true

# Only used when WHATSAPP_VENDOR_WORKBOOK=false.
WHATSAPP_VENDOR_MESSAGE_MAX_LINES=20


# =====================================================================
#  3. SALES TEAM — stock check -> confirm -> purchase team       [NEW]
# =====================================================================
# Registered sales numbers ask "is this part available?" and get
# availability + quantity back. Never the vendor, never the price.
# "confirm <customer name>" turns the answer into a real order, and the
# buying list goes to the PURCHASE team only.

# How long the quoted QUANTITIES stay trustworthy (minutes). Past this a
# confirm re-checks the stock, shows what is available right now, and
# asks again — the parts are never thrown away. 0 = never stale.
WHATSAPP_SALES_QUOTE_TTL_MINUTES=60

# Hard ceiling (hours). Beyond this even the re-check is not offered and
# the member is asked to send the parts again. 0 = no ceiling.
WHATSAPP_SALES_QUOTE_MAX_AGE_HOURS=24

# How long "same customer as last time?" stays on offer (hours). ALWAYS
# shown and confirmed, never applied silently — one sales person serves
# many customers. 0 = always ask for the name.
WHATSAPP_SALES_CUSTOMER_MEMORY_HOURS=12

# OPTIONAL single reminder for an unconfirmed quote, asked ONCE and never
# repeated. 0 = off (recommended to start): with ten people asking all
# day, unprompted nudges become noise. Try 15 or 30 if they forget.
WHATSAPP_SALES_NUDGE_MINUTES=0


# =====================================================================
#  4. DEALER PORTAL — vendor stock push                          [NEW]
# =====================================================================
#  WHAT THIS PUSHES: vendor STOCK (inventory), not orders. Customer
#  orders never leave ProcureHub — they go order -> allocation ->
#  purchase-team workbook. Orders are punched on DP manually by CRM.
#
#  THE HOST MOVED (4 Sep 2026). The old vagmine.mycentralpark.in no
#  longer completes a TLS handshake — it is dead, not renamed. Verified
#  working: login returns 200 with stock.upload permission.
DEALER_PORTAL_BASE_URL=https://vagmine.vagminetech.com/api/v1

# MASTER SWITCH. false = no delta computed, no audit row, no network
# call; ProcureHub behaves exactly as today. Turn on only when the vendor
# usernames below are filled in.
DEALER_PORTAL_ENABLED=false

# SHADOW MODE — leave TRUE for the first several days.
# Computes the full delta, writes the audit row, logs the exact CSV it
# WOULD send, and transmits nothing. Read the logs for zeroed_count and
# failed_count before a single byte reaches DP.
DEALER_PORTAL_SHADOW=true

# ---------------------------------------------------------------------
#  4a. NEVER PUSH — own stock                    [decided on the call]
# ---------------------------------------------------------------------
# Bijwasan, Mansarovar and Jaipur stock is EXPORTED OUT OF DP's own ERP
# in the first place — Harun pulls it from DP, then sends it on WhatsApp.
# Pushing it back would DOUBLE the same stock inside DP.
#
#   "dealer portal pe apna stock already hai, exist kar raha hai,
#    wahi se main nikal ke deta hoon aapko"     — Harun, 4 Sep 2026
#
# This REVERSES section 8(a) of the original spec. Note MAANSAROVAR with
# a double A — that is how it is actually spelled on DP (dealer 1078),
# a third spelling beyond Mansarovar/Mansarover. All variants listed.
DEALER_PORTAL_EXCLUDE_VENDORS=Bijvasan, Bijwasan, Bijwashan, Mansarovar, Mansarover, Maansarovar, Jaipur

# ---------------------------------------------------------------------
#  4a-2. WHICH DP DEALER? — asked ONCE over WhatsApp, then remembered
# ---------------------------------------------------------------------
# Several DP accounts routinely share a vendor's name:
#     113   A. K. Motors Fbd          (bulk_dealer)
#     1366  A K Motors (Debtors)      (bulk_dealer)
#     1367  A K Motors Karol Bagh     (bulk_dealer)
# Guessing would file one vendor's stock under another dealer's id, and
# nobody would notice until accounts could not reconcile. So ProcureHub
# never guesses — the first time a vendor's stock is ready to push, the
# admin number(s) get:
#
#     ❓ Dealer Portal mapping needed
#     Vendor: Karol Bagh
#     1. [119] Karol Bagh Branch          type: bulk_dealer
#     2. [460] KAROL BAGH WAREHOUSE       type: cartrend_dealer ⛔
#     3. [3784] Karol Bagh Retail Sales   type: bulk_dealer
#     Reply "dp 1", or "dp 1367" (a dealer id), or "dp skip".
#
# The answer is saved in the dealer_portal_vendor_map table and the question
# is NEVER asked again for that vendor. The import is never affected — it
# has already committed; only the push waits.
#
# A ⛔ candidate is a CarTrends warehouse (DP's own dealer_type says so —
# only 7 of 8,326 dealers are cartrend_dealer). Picking one is REFUSED: that
# stock is exported OUT of DP, so pushing it back would double it.
#
# Nothing to configure here. The questions go to WHATSAPP_ADMIN_PHONE_NUMBER.

# ---------------------------------------------------------------------
#  4b. WHICH VENDORS DO GET PUSHED
# ---------------------------------------------------------------------
# Only EXTERNAL vendors — the ones who send us stock DP does not already
# hold. Each key below is a label of your choosing; it never leaves
# ProcureHub.
#
# Uncomment and add keys as their usernames arrive. Start with ONE.
#
#   DEALER_PORTAL_ACCOUNTS=NORTHEND
#
# Confirmed on DP (dealer_id shown for your reference only — it is NEVER
# sent; DP reads the dealer from the login token):
#
#     29    Northend Distributors
#     2818  Ess Aay Automotive
#     1367  A K Motors Karol Bagh     <- or 113 "A. K. Motors Fbd"?
#     ????  Karol Bagh vendor         <- Harun says one account exists,
#                                        but DP shows 119 Branch / 460
#                                        WAREHOUSE / 3784 Retail Sales.
#                                        Which one is the vendor?
#
# _VENDORS is a GROUP: list every spelling of that vendor as it appears
# in ProcureHub. Matched as whole words, so "Northend" also catches
# "Northend Distributors" and "Northend Auto" but never "Northendura".
# Either a vendor NAME or an exact vendor_code (NS_CT) works.
#
# _FULL_SNAPSHOT: true means parts absent from today's file are pushed as
# quantity 0 (the sold-out fix). Only for vendors CONFIRMED to send a
# COMPLETE daily list. Start everyone at false — on a partial file, true
# would wipe their real stock in DP.

# ---- OPTION A: one JSON file for every vendor (recommended) ----------
# Three env lines per vendor does not scale past a handful. Point this at a
# file instead and the whole vendor list lives in one place -- adding a
# vendor is one JSON object, no .env edit, no line sprawl.
#
#   cp backend/dp_accounts.example.json backend/dp_accounts.json
#   chmod 600 backend/dp_accounts.json          # and keep it out of git
#
# Still NOT the database: the spec's rule is that credentials never sit in
# the DB in plaintext and never reach a log. A file read at runtime honours
# both, and it is exactly what Docker secrets / a mounted volume are for.
# DEALER_PORTAL_ACCOUNTS_FILE=backend/dp_accounts.json

# ---- OPTION B: env lines, fine for one or two vendors ----------------
# Both forms work together. If a key appears in BOTH, the ENV one wins, so a
# single vendor can always be overridden without touching the file.
# DEALER_PORTAL_ACCOUNTS=NORTHEND
# DEALER_PORTAL_NORTHEND_USERNAME=<ask Vineet / Harun>
# DEALER_PORTAL_NORTHEND_PASSWORD=<paste yourself, never in chat>
# DEALER_PORTAL_NORTHEND_VENDORS=Northend
# DEALER_PORTAL_NORTHEND_FULL_SNAPSHOT=false

# Once permanent tokens exist (spec open question #1), replace USERNAME
# and PASSWORD with a single line and the login call disappears — no
# 8-hour expiry, no device_id, no 409 SESSION_ALREADY_ACTIVE:
# DEALER_PORTAL_NORTHEND_TOKEN=<permanent token>

# ---------------------------------------------------------------------
#  4c. Dealer Portal tuning — defaults are fine
# ---------------------------------------------------------------------
# ProcureHub has no per-row TAT, so this is sent for every row.
DEALER_PORTAL_TAT_DAYS=3

# How a part appearing twice is collapsed. DP itself SUMS duplicates,
# which silently inflates stock — we never inherit that. "max" takes the
# largest single stated availability. Also: "sum", "first".
DEALER_PORTAL_DUPLICATE_STRATEGY=max

DEALER_PORTAL_TIMEOUT_SECONDS=60

# Retry sweep for pushes left FAILED. Safe to repeat — DP's upload is an
# absolute replace, so the same CSV twice cannot double-count.
# 0 disables the sweep.
DEALER_PORTAL_RETRY_INTERVAL_MINUTES=30
DEALER_PORTAL_RETRY_MAX_ATTEMPTS=5

# NOTE — AFTER A DATA PURGE. Purging vendor data deletes every
# InventoryImport row (for ALL vendors, not one), so there is no previous
# snapshot and the next push zeroes nothing: DP silently keeps stale
# stock. Re-import the current files, then run:
#     python -m backend.scripts.dealer_portal_resync --all --full
# Use --dry-run first to see exactly what would be sent.


# =====================================================================
#  5. GOOGLE SHEETS — timeout fix               [fixes a real failure]
# =====================================================================
# You hit this on 3 Sep: "Google Sheet update failed. Vendor: BIJWASHAN
# STOCK. Read timed out (read timeout=30.0)".
#
# Every sync rewrites the vendor's ENTIRE sheet in one API call, and
# Bijwashan is your largest file. 30s was not enough. Nothing broke —
# the import committed, only the Sheet copy went stale, and the next
# upload rewrites it. But it will recur at 30s.
GOOGLE_SHEETS_READ_TIMEOUT=120
GOOGLE_SHEETS_CONNECT_TIMEOUT=15


# =====================================================================
#  6. OWN STOCK — allocation priority        [verify, do not guess]
# =====================================================================
# Own-stock vendors are ALWAYS allocated from first, whatever strategy is
# chosen. Matched case-insensitively as whole words, so "Bijwasan" also
# catches "BIJWASAN HUB" but never "Bijwasannual Traders".
#
# NOTE: DP spells it MAANSAROVAR (double A). If ProcureHub ever receives
# a file under that spelling, add it here too or it loses own-stock
# priority. Jaipur is deliberately NOT here — adding it would change
# ALLOCATION behaviour, which is a separate decision from the DP push.
# Tell me if Jaipur should be own stock for allocation as well.
OWN_STOCK_VENDOR_NAME=Bijvasan, Bijwasan, Mansarovar, Mansarover


# =====================================================================
#  7. Small things worth setting explicitly
# =====================================================================
# Auto top-up: a vendor's new stock fills still-unfilled lines of recent
# customer orders. Adds only; never moves an existing allocation.
TOPUP_ON_NEW_STOCK=true
TOPUP_WINDOW_DAYS=7

# Group several files from one sender under the same command/vendor name
# without re-asking. 0 disables grouping.
WHATSAPP_GROUPING_WINDOW_MINUTES=10

# Auto vendor selection for imported customer orders, then ONE ZIP of
# allocation reports once order imports go quiet.
WHATSAPP_AUTO_ALLOCATION_ENABLED=true
WHATSAPP_ALLOCATION_BATCH_DEBOUNCE_SECONDS=20

# The COMBINED per-order workbook. You found it hard to read on 25 Aug,
# so it stays off — the per-vendor workbook in section 2 replaced it.
WHATSAPP_SEND_ALLOCATION_REPORT=false

# Fuzzy vendor-name matching on upload. Keep true so a small spelling
# slip does not onboard a duplicate vendor.
VENDOR_NAME_FUZZY_ENABLED=true
