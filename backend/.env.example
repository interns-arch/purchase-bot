# Backend configuration -- copy this file to `backend/.env` and fill in
# real values. `backend/.env` itself is git-ignored -- never commit real
# secrets. Every value below is read from an environment variable; nothing
# is hardcoded in source. If a required credential for an enabled
# integration is missing, that integration logs a clear error and no-ops
# (or the affected background job skips its run) instead of crashing the
# whole app -- see each integration's own config.py for the exact fallback
# behavior.

# --- Core app ---------------------------------------------------------

# Secret used to sign JWTs. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY is accepted as a fallback alias if JWT_SECRET_KEY isn't set.
JWT_SECRET_KEY=
SECRET_KEY=

# JWT signing algorithm. HS256 unless you have a specific reason to change it.
ALGORITHM=HS256

# How long an access token stays valid, in minutes.
# ACCESS_TOKEN_EXPIRE_MINUTES is accepted as a fallback alias if
# JWT_EXPIRE_MINUTES isn't set.
JWT_EXPIRE_MINUTES=480
ACCESS_TOKEN_EXPIRE_MINUTES=

# Frontend origins allowed to call this API (comma-separated). Never use "*"
# in production -- list exact origins (local dev + your Vercel URL).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# One-time admin bootstrap: on startup, if no user accounts exist yet, a
# user is created from these two values. Ignored once any user exists --
# to change the password afterwards use:
#   python -m backend.scripts.create_admin --username admin --reset
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional: a Postgres connection string (e.g. hosted Neon). Leave unset to
# fall back to the local database/app.db SQLite file.
DATABASE_URL=

# Minimum log level for every logger created via core.logging_setup.get_logger.
LOG_LEVEL=INFO

# --- Uploads -------------------------------------------------------------
# Document Processing Engine folder structure -- see
# backend/app/services/document_processor/staging.py. All paths are
# relative to the repository root.

# Where successfully processed files end up.
UPLOAD_DIR=uploads/processed
# Where every incoming file (manual upload, WhatsApp download, or Gmail
# attachment) lands before it's classified and processed.
TEMP_UPLOAD_DIR=uploads/incoming
# Reserved for a future retention/cleanup job -- created but not used yet.
ARCHIVE_UPLOAD_DIR=uploads/archive
# Where failed / needs-review / unsupported files end up.
FAILED_UPLOAD_DIR=uploads/failed

# Reject an upload once it exceeds this many megabytes (enforced while
# streaming to disk, not just after).
MAX_UPLOAD_SIZE_MB=25

# --- Automatic Vendor Selection (rule engine) -----------------------------
# See core/services/rules/. Strategy used when POST
# /api/vendor-selection/{order_id}/auto-select is called without an explicit
# ?strategy= query param. One of: highest_quantity | minimum_vendors | combination
VENDOR_SELECTION_DEFAULT_STRATEGY=combination

# Own Stock Priority: a COMMA-SEPARATED list of vendor names treated as the
# company's own stock -- these are ALWAYS allocated first, before any
# external vendor, regardless of the strategy above (several own-stock
# vendors are drawn from biggest available stock first). Only the remaining
# quantity (if any) is then split across external vendors by the strategy.
# Defaults to "Bijvasan, Bijwasan, Mansarovar, Mansarover" if unset (both
# warehouses, every spelling variant) -- so simply uploading an inventory
# file under any of those names activates own-stock priority, no DB flag
# or UI needed. Each name matches case-insensitively as a WHOLE WORD, so
# "BIJVASAN", "BIJWASAN HUB", "Bijwasan Warehouse" and "Mansarovar Depot"
# all count, but an unrelated "Bijwasannual Traders" does not. Leave BLANK
# to disable name-based detection (the Vendor.is_own_stock DB flag still
# works either way). See core/services/own_stock.py.
OWN_STOCK_VENDOR_NAME=Bijvasan,Bijwasan,Mansarovar,Mansarover

# Auto top-up: when a vendor uploads NEW stock, recent customer orders that
# are still short get topped up from it. ADDS ONLY -- an allocation that
# already exists is never moved or reduced, so anything already communicated
# to a vendor stays valid. Only orders created within TOPUP_WINDOW_DAYS are
# considered, so old orders are never quietly modified. The Founder gets one
# notification listing exactly what was filled (silent when nothing changed).
TOPUP_ON_NEW_STOCK=true
TOPUP_WINDOW_DAYS=7

# --- WhatsApp Business Cloud API ---------------------------------------
# See backend/app/integrations/whatsapp/. The app works fully today with
# these left blank -- WHATSAPP_ENABLED=false means the webhook route
# no-ops on every POST. No source changes are needed to go live: set
# WHATSAPP_ENABLED=true and fill in the values below once you've created a
# Meta Business App + WhatsApp Business Account and configured the webhook
# at https://developers.facebook.com/apps -> your app -> WhatsApp -> Configuration.
# See the README's "WhatsApp Business Setup" section for the full walkthrough.

# ENABLE_WHATSAPP_AUTOMATION is accepted as a fallback alias.
WHATSAPP_ENABLED=True
ENABLE_WHATSAPP_AUTOMATION=
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_API_VERSION=

# Meta Graph API access token for the WhatsApp Business Account (permanent
# system-user token recommended over a short-lived one for production).
WHATSAPP_ACCESS_TOKEN=

# The phone number ID from Meta's App Dashboard (WhatsApp -> API Setup).
WHATSAPP_PHONE_NUMBER_ID=

# The WhatsApp Business Account ID. META_BUSINESS_ID is accepted as a
# fallback alias (same value, Meta's more generic name for it).
WHATSAPP_BUSINESS_ACCOUNT_ID= 
META_BUSINESS_ID=

# Your Meta App's ID and App Secret (App Dashboard -> Settings -> Basic).
# META_APP_ID / META_APP_SECRET are accepted as fallback aliases -- WhatsApp
# is one product inside a single Meta App, so these are the same
# credentials either way. The App Secret is required for webhook signature
# verification (X-Hub-Signature-256) -- without it, incoming webhook
# payloads are accepted unsigned, which is fine for local testing but must
# be set before exposing the webhook publicly. WHATSAPP_WEBHOOK_SECRET is
# also accepted as a fallback alias for this same value.
WHATSAPP_APP_ID= 
META_APP_ID=
WHATSAPP_APP_SECRET=
META_APP_SECRET=
WHATSAPP_WEBHOOK_SECRET=


# The token Meta's webhook verification handshake (GET /api/whatsapp/webhook)
# must echo back -- choose any string, then enter the SAME value when
# configuring the webhook in the Meta App Dashboard.
# WHATSAPP_WEBHOOK_VERIFY_TOKEN is Meta's documented name for this;
# WHATSAPP_VERIFY_TOKEN is accepted as a fallback alias.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# The public HTTPS URL Meta should POST webhook events to, e.g.
# https://your-domain.example.com/api/whatsapp/webhook (use ngrok or
# similar for local development). Informational -- this app doesn't read
# it directly, but it's the value you'll enter in the Meta App Dashboard.
WHATSAPP_WEBHOOK_CALLBACK_URL=

# Founder/admin WhatsApp number(s) that receive every founder-facing
# message: the consolidated Vendor Inventory workbook, allocation reports,
# mirrored notifications, and the daily stock summary. COMMA-SEPARATED for
# several numbers (e.g. 919876543210,919812345678) -- each listed number
# gets everything and may use the admin commands ("send reminder",
# "register"). International format WITHOUT a leading '+'. Reuses
# WHATSAPP_ACCESS_TOKEN / WHATSAPP_PHONE_NUMBER_ID above -- no separate
# auth. If left blank, founder-facing sends are simply skipped (imports
# still succeed).
WHATSAPP_ADMIN_PHONE_NUMBER=

# Mirror every UI toast notification (import results, workbook/Sheet
# updates, allocation outcomes, failures) as a WhatsApp text message to
# WHATSAPP_ADMIN_PHONE_NUMBER -- the same events the web UI shows, without
# keeping it open. Needs the admin number above; set to false to turn the
# mirror off.
WHATSAPP_FORWARD_NOTIFICATIONS=true

# Send generated FILES to WhatsApp (the consolidated Vendor_Inventory.xlsx
# after vendor imports; allocation report workbooks after automatic vendor
# selection). Set either to false to keep the chat text-only -- the workbook
# stays downloadable on the web (Vendor Inventory -> Download Workbook), the
# Google Sheet still updates, and allocations still run and export as usual.
WHATSAPP_SEND_WORKBOOK=true
WHATSAPP_SEND_ALLOCATION_REPORT=true

# VENDOR-WISE PURCHASE OUTPUT after an allocation batch: ONE Excel with ONE
# SHEET PER VENDOR (Founder, 1 Sep 2026). Tabs are named after the vendors
# ("Bijwasan", "Northend", "Jaipur"); each vendor sheet lists
#     Part Number | Vendor Part Number | Customer Requested |
#     Vendor Available | Allocated Qty | Status | Customer Order
# so a Partial allocation explains itself -- a text message can only carry
# "part x quantity". A leading Summary tab indexes the vendors.
#
# Internal only: it shows every vendor we buy from and at what quantity, so
# it goes to WHATSAPP_ADMIN_PHONE_NUMBER and the registered purchase team
# (the same recipients as before), never to a vendor. A vendor's own
# document remains the Purchase Order.
#
# false restores one text message per vendor. Those texts are ALSO the
# automatic fallback if the workbook cannot be built or delivered, so a
# spreadsheet problem never costs the Founder the purchase instructions.
WHATSAPP_VENDOR_WORKBOOK=true

# A single vendor with more purchase lines than this gets a small Excel
# instead of an unreadable wall of text (only used when
# WHATSAPP_VENDOR_WORKBOOK=false).
WHATSAPP_VENDOR_MESSAGE_MAX_LINES=20

# Send each generated Purchase Order on WhatsApp (the Founder's 3-recipient
# rule): the vendor's registered number (their OWN PO only), every
# purchase-team member (register via 'register team' on WhatsApp), the
# number that originally sent the order, and the admin number(s).
# SEND_PO=false disables all of it; SEND_PO_TO_VENDOR=false keeps it
# internal (team + admin only).
WHATSAPP_SEND_PO=true
WHATSAPP_SEND_PO_TO_VENDOR=true

# The Founder's OVERDUE rule: a PO counts as overdue when the vendor's
# invoice has not been uploaded within this many hours of PO generation.
PO_INVOICE_DUE_HOURS=24

# When an import FAILS (or needs review), send the ORIGINAL file back to the
# admin number(s) right in the chat -- the file that failed is exactly the
# one worth opening, and the server's copy is cleared by restarts while the
# WhatsApp copy stays forever. false = send only the failure message.
WHATSAPP_SEND_FAILED_FILE=true

# Master switch for the number-registry fast path (registered vendors/
# customers sending files directly, no command/caption). false = suspend:
# registrations stay saved, but every number gets the classic command/
# caption flow until re-enabled. The Founder's "register" contact-list flow
# keeps working either way.
WHATSAPP_NUMBER_REGISTRY_ENABLED=true

# --- Daily vendor stock automation (WhatsApp number registry) -------------
# Vendors/customers whose numbers are REGISTERED (Settings/seed script) send
# files directly -- no command, no caption, no filename rules; the number
# alone identifies the party. These settings drive the daily cycle around
# that. All times are IST (HH:MM, 24h).
#
# Morning "please share your stock" template to every registered vendor
# number. KEEP DISABLED until the template below is APPROVED in the Meta
# dashboard (business-initiated messages require an approved template).
WHATSAPP_DAILY_REQUEST_ENABLED=false
WHATSAPP_DAILY_REQUEST_TIME=09:30
# Daily received/pending participation summary to WHATSAPP_ADMIN_PHONE_NUMBER
# (plain text, no template needed). Reply "send reminder" to nudge pending
# vendors on demand.
WHATSAPP_DAILY_SUMMARY_ENABLED=true
WHATSAPP_DAILY_SUMMARY_TIME=11:00
# Optional automatic reminder to STILL-PENDING vendors (e.g. 11:30).
# Empty = disabled; the manual "send reminder" text works either way.
WHATSAPP_AUTO_REMINDER_TIME=
# Approved Meta template names + language. The reminder template defaults to
# the stock-request template (one approved template can serve both).
WHATSAPP_STOCK_REQUEST_TEMPLATE=stock_request
WHATSAPP_REMINDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en

# When several vendor files arrive in one WhatsApp batch, each successful
# import requests the consolidated workbook; requests within this many
# seconds of each other are coalesced so ONE final workbook is sent per
# batch (0 = send immediately after every import).
WHATSAPP_WORKBOOK_DEBOUNCE_SECONDS=20

# Automatic vendor selection for imported customer orders ("Combined ZIP"
# mode): after order imports go quiet for the debounce window, every pending
# order is auto-selected IN ARRIVAL ORDER (each customer consumes stock
# before the next) and ONE ZIP of vendor_allocation_order_<id>.xlsx reports
# is sent to WHATSAPP_ADMIN_PHONE_NUMBER. Set the flag to false to keep
# vendor selection fully manual. 0 seconds = one ZIP per order, immediately.
WHATSAPP_AUTO_ALLOCATION_ENABLED=true
WHATSAPP_ALLOCATION_BATCH_DEBOUNCE_SECONDS=20

# Not applicable here: this app never stores a fixed WHATSAPP_DOWNLOAD_URL --
# the Graph API returns a fresh, short-lived media URL per attachment (see
# backend/app/integrations/whatsapp/client.py's get_media_url), so there's
# nothing to configure for it.

# --- Gmail Customer Order Automation --------------------------------------
# See backend/app/integrations/gmail/. Reads unread mail from a DEDICATED
# mailbox, downloads Excel attachments, and imports them as Customer Orders
# -- the same import path the manual Customer Orders upload uses. Disabled
# (no polling job is scheduled) unless enabled below.

# ENABLE_EMAIL_AUTOMATION is accepted as a fallback alias.
GMAIL_ENABLED=false
ENABLE_EMAIL_AUTOMATION=

# Which client backend to use -- "imap" (App Password) or "oauth" (Gmail API
# refresh token). Switching modes only requires changing this value and the
# corresponding credentials below; no code changes.
GMAIL_AUTH_MODE=imap

# --- imap mode ---
# The Gmail address to poll, and an App Password for it (Google Account ->
# Security -> 2-Step Verification -> App Passwords -- requires 2FA to be
# enabled on the account). Do NOT use the account's real login password.
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
GMAIL_IMAP_SERVER=imap.gmail.com
GMAIL_IMAP_PORT=993

# --- oauth mode ---
# From a Google Cloud project with the Gmail API enabled and an OAuth 2.0
# Client ID (Desktop app type works for a one-time consent flow). Run the
# OAuth consent flow once (see README's "Gmail Setup" section) to mint a
# refresh token -- GMAIL_REFRESH_TOKEN never expires unless revoked.
#
# IMPORTANT: these SAME three OAuth values are also reused for Google Sheets
# Sync (below) -- there is no separate service account anymore. If you enable
# Google Sheets Sync, mint the refresh token with BOTH scopes:
#   https://www.googleapis.com/auth/gmail.modify
#   https://www.googleapis.com/auth/spreadsheets
# and enable BOTH the Gmail API and the Google Sheets API in the project.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# How often (seconds) the background scheduler polls the mailbox.
GMAIL_POLL_INTERVAL_SECONDS=300

# Sender whitelist: comma-separated email addresses. When set, ONLY unread
# mails FROM these exact addresses are read and their attachments imported --
# every other email in the inbox is completely ignored (never fetched, never
# marked read). Display names are handled automatically
# ("Rahul Traders <rahul@acme.com>" matches "rahul@acme.com"); matching is
# case-insensitive. Leave empty to process all unread mails with attachments
# (the historical behaviour).
# Example: GMAIL_ALLOWED_SENDERS=orders@boodmo.com,rahul@acmetraders.com
GMAIL_ALLOWED_SENDERS=

# Attachment-name filter: only extract attachments whose name STARTS WITH
# this prefix (case-insensitive; anything may follow). One matching file is
# extracted alone; several matching files are ALL extracted; every other
# attachment in the email is ignored. Empty = extract all usable
# Excel/PDF attachments.
# Example: GMAIL_ATTACHMENT_PREFIX=purchase_order
GMAIL_ATTACHMENT_PREFIX=

# Import every extracted attachment under this fixed name instead of its
# original name (original is logged). If no extension is given here, the
# attachment's own extension is appended automatically. Empty = keep
# original names.
# Example: GMAIL_SAVE_ATTACHMENT_AS=purchase_order.xlsx
GMAIL_SAVE_ATTACHMENT_AS=

# Only process emails received TODAY (IST). An unread mail left over from a
# previous day is never imported -- it stays unread and untouched. Default
# true; set false to process any unread mail regardless of age.
GMAIL_PROCESS_TODAY_ONLY=true

# Process emails even after a human has OPENED them (default true). The old
# unread-only behaviour silently skipped any mail someone read before the
# poller ran (e.g. the server was asleep when it arrived and the inbox was
# checked manually). Safe: every processed email's id is recorded in the
# database and skipped on re-poll, so nothing ever imports twice. Set false
# to restore unread-only.
GMAIL_PROCESS_READ_EMAILS=true

# WhatsApp conversation grouping window (minutes): more files from the same
# number within this window reuse the same command and (for vendor files)
# the same supplied vendor name automatically -- no re-asking per file.
# Each file restarts the window. 0 = ask per file (legacy).
WHATSAPP_GROUPING_WINDOW_MINUTES=10

# --- Google Sheets Sync ---------------------------------------------------
# See backend/app/integrations/google_sheets/. Every vendor inventory import
# (manual or WhatsApp) pushes that vendor's active inventory to its own
# worksheet in this spreadsheet automatically once enabled.
#
# AUTH: this now reuses the SAME OAuth credentials as Gmail above
# (GMAIL_CLIENT_ID / GMAIL_CLIENT_SECRET / GMAIL_REFRESH_TOKEN) -- there is NO
# service account anymore (GOOGLE_SERVICE_ACCOUNT_JSON was removed). The Gmail
# refresh token must be minted with the spreadsheets scope (see the oauth mode
# note above), and the Google Sheets API must be enabled in the same project.
# You still just share the target sheet with the Google ACCOUNT that consented
# the OAuth flow (Editor access) -- not a service-account email.
ENABLE_GOOGLE_SHEETS_SYNC=false

# The spreadsheet's ID (the long id in its URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit). Share the sheet
# with the Google account that consented the OAuth flow, with Editor access.
GOOGLE_SHEET_ID=

# Daily reset (Founder rule: the Sheet shows ONLY same-day uploads): every
# morning at this IST time, vendor-code worksheets whose vendor has NOT
# uploaded stock today are deleted; a vendor's tab reappears the moment
# their file imports. Hand-made tabs (titles that aren't a Vendor Code) are
# never touched. Runs only while the sync itself is enabled.
GOOGLE_SHEETS_DAILY_RESET_ENABLED=true
GOOGLE_SHEETS_DAILY_RESET_TIME=09:15

# Informational only -- not read directly by this app, just documents which
# Google Cloud project the OAuth client above belongs to.
GOOGLE_PROJECT_ID=

# --- Automatic Vendor Allocation Report email ------------------------------
# After every AUTOMATIC vendor selection (not manual), the resulting Vendor
# Allocation Excel is emailed here automatically -- using the same Gmail
# account configured above (see backend/app/integrations/gmail/mailer.py).
# Leave unset to skip this email entirely (logged, not an error). Manual
# export from the UI always continues to work either way.
ALLOCATION_REPORT_EMAIL=

# --- Purchase Order generation & internal email ----------------------------
# After every automatic vendor selection, one Purchase Order is generated
# per selected vendor (see core/services/purchase_order_generation_service.py)
# and is always saved + downloadable from the UI regardless of the settings
# below. Purchase Orders are NEVER sent to vendors -- only, optionally,
# emailed to your own internal purchase team for review.

# Set to true to also email each generated Purchase Order's Excel to
# PURCHASE_TEAM_EMAIL (same Gmail account as above). Generation/saving still
# happens even if this is false or the email fails -- POs stay downloadable
# from the UI regardless. Left false by default so the app runs fully in
# manual mode with no email configured.
ENABLE_PO_EMAIL=false
PURCHASE_TEAM_EMAIL=

# Reserved for a future phase -- sending Purchase Orders directly to VENDORS
# over WhatsApp Business is not implemented yet (this app currently only
# ever emails generated POs to your own internal team, never to a vendor).
# Left here, unused, so the toggle already exists once that phase is built.
ENABLE_PO_WHATSAPP=false

# Company details printed on every generated Purchase Order.
COMPANY_NAME=
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=

# --- Background Automation ------------------------------------------------
# These are read directly by the integrations above (ENABLE_EMAIL_AUTOMATION
# gates the Gmail polling job scheduled in backend/app/workers/scheduler.py;
# ENABLE_GOOGLE_SHEETS_SYNC gates the sync call after each inventory import;
# WhatsApp has no separate polling job -- it's driven by Meta's webhook, see
# WHATSAPP_ENABLED above). Listed together here for a single place to see
# every automation on/off switch at a glance.
# ENABLE_WHATSAPP_AUTOMATION=false
# ENABLE_EMAIL_AUTOMATION=false
# ENABLE_GOOGLE_SHEETS_SYNC=false
# ENABLE_PO_EMAIL=false
# ENABLE_PO_WHATSAPP=false (reserved, not implemented yet)

# --- Document Understanding / AI (Architecture V2) --------------------------
# PHASE 1 = SCAFFOLDING ONLY. With every value below left as-is, the provider
# registry returns NullProvider and the import pipeline behaves EXACTLY as it
# always has (deterministic parsers only). Nothing is sent anywhere.
#
# Which provider implements DocumentUnderstandingProvider.
# null (default) | nvidia
AI_PROVIDER=null

# API key for the selected provider. NEVER commit a real key; set it in the
# Render dashboard for production. Not required for a local `ollama` provider.
# If AI_PROVIDER names a cloud provider and this is blank, the app safely
# falls back to NullProvider (logged, not an error).
AI_API_KEY=

# Optional model id override (e.g. a specific Gemini/OpenAI/Ollama model).
AI_MODEL=

# Master switch for AI-ASSISTED RESCUE of Vendor Inventory files whose
# headers the deterministic parser cannot recognize -- for BOTH Vendor
# Inventory and Customer Order files (customer files vary most: every customer
# writes their own column names, e.g. "Suzuki Part No. (No Dash)" /
# "Suzuki Order Qty"). The model proposes ONLY a column mapping; the mapping
# is strictly validated (money/MRP/discount/float-stock can never become
# quantity, confidence floor), the model's sampled rows are cross-checked
# against a deterministic re-read of the file, and the actual import re-reads
# the WHOLE file with that mapping through the normal import pipeline --
# every stored value comes from the file, never from the model. Runs ONLY
# after the deterministic parser failed. Set false to instantly roll back to
# deterministic-only behaviour.
#
# A rescued layout is REMEMBERED (learned_file_formats), so the next file with
# the same headers imports with no model call at all.
#
# MUST be true for any of this to happen: with false the model may still be
# called in shadow mode, but its answer is only logged and the import still
# fails.
AI_FALLBACK_ENABLED=true

# Master switch for natural-language WhatsApp commands (Phase 6).
AI_INTENT_ENABLED=true

# SHADOW MODE (Phase 2B) -- observation only, SEPARATE from AI_FALLBACK_ENABLED.
# When true AND a real provider is configured, a Vendor Inventory file that the
# deterministic parser could NOT read is additionally sent to the model, and
# what it would have extracted (plus the strict validator's verdict) is written
# to the LOGS only. Nothing is imported: the document keeps its FAILED status
# and no VendorInventory/Part/PartAlias/Vendor row is created or updated.
# Safe to enable in production to gather real accuracy data before Phase 2C.
AI_SHADOW_MODE=false

# Cost control: how many leading rows of a spreadsheet are sampled into the
# compact representation sent to the provider (never the whole file).
AI_MAX_ROWS_SAMPLE=40

# Hard timeout for a single provider call, in seconds. 30 is too tight for a
# real document (a 40-row sample plus instructions): measured against
# meta/llama-3.1-70b-instruct, a trivial prompt answers in ~1s but a full
# document prompt needs longer, and a timeout silently produces no rescue.
AI_TIMEOUT_SECONDS=60

# Minimum extraction confidence; below this the document becomes NEEDS_REVIEW
# instead of being imported.
AI_CONFIDENCE_THRESHOLD=0.7

# --- NVIDIA-hosted models (used when AI_PROVIDER=nvidia) --------------------
# API key from https://build.nvidia.com/ -- read from the environment ONLY and
# never logged. Set it in the Render dashboard for production; NEVER commit a
# real key. If AI_PROVIDER=nvidia and this is blank, the app logs a warning and
# safely falls back to NullProvider (no crash, deterministic behaviour kept).
# AI_API_KEY is accepted as a fallback if NVIDIA_API_KEY is unset.
NVIDIA_API_KEY=

# Model id. Set AI_MODEL to override the provider default. Verify the id is
# actually available to your account with:
#   python -m backend.scripts.test_nvidia_connection
#
# IMPORTANT: being LISTED by the provider does not mean it answers.
# google/gemma-4-31b-it is listed but did not respond at all when measured
# (no reply in 120s on a one-word prompt), which silently disabled every
# rescue. meta/llama-3.1-70b-instruct answered the same prompt in ~1s.
AI_MODEL=meta/llama-3.1-8b-instruct
# Only needed for a non-standard endpoint (default https://integrate.api.nvidia.com/v1).
NVIDIA_BASE_URL=

# Maximum tokens the model may return for one extraction.
NVIDIA_MAX_TOKENS=4096


# =====================================================================
# DEALER PORTAL STOCK PUSH
# =====================================================================
# Dealer Portal (DP) is becoming the single centralized repository for all
# vendor stock -- what Odoo, the accounts team, the sales mobile app and
# Shopify read from. ProcureHub keeps its WhatsApp intake, its parsing, its
# database and its allocation engine; what is ADDED is that each successful
# vendor inventory import is also pushed into DP under that vendor's own DP
# dealer account.
#
# WHY PROCUREHUB HAS TO COMPUTE A DELTA
# DP's upload is an "absolute upsert": a part present in the CSV has its
# quantity REPLACED, and a part ABSENT from the CSV is left unchanged
# FOREVER -- never zeroed. Vendor files are daily snapshots, so a part that
# sold out simply vanishes from tomorrow's file and DP keeps telling the
# sales bot it is in stock. DP cannot be asked what it holds either
# (GET /stock/ is HTTP 500 on the live environment). So ProcureHub compares
# the new import against the previous one and sends the sold-out parts
# explicitly with quantity 0. That is the entire point of this integration.
#
# Everything below defaults to OFF/safe. With DEALER_PORTAL_ENABLED unset,
# ProcureHub behaves exactly as it does today.

# Master switch. false = no delta, no audit row, no network call.
DEALER_PORTAL_ENABLED=false

# Shadow mode. TRUE BY DEFAULT and deliberately so: turning
# DEALER_PORTAL_ENABLED on must not be able to write to a real dealer
# account by accident. In shadow mode the full delta is computed, a
# dealer_portal_pushes row with status=SHADOW is written, the exact CSV that
# WOULD be sent is logged -- and nothing is transmitted. Run it against real
# vendor uploads for several days, read the logs (especially zeroed_count),
# and only then set this to false.
DEALER_PORTAL_SHADOW=true

DEALER_PORTAL_BASE_URL=https://vagmine.mycentralpark.in/api/v1

# ---------------------------------------------------------------------
# ACCOUNTS -- one block per DP dealer account
# ---------------------------------------------------------------------
# List the account keys here, then give each one its own block below. A key
# is just a label you choose (A-Z, 0-9, underscore); it never leaves
# ProcureHub and does not have to match anything in DP.
DEALER_PORTAL_ACCOUNTS=

# NEVER PUSH THESE — own stock (Harun + Founder, call of 4 Sep 2026).
#
# Bijwasan, Mansarovar and Jaipur stock is EXPORTED OUT OF Dealer Portal's
# own ERP in the first place: Harun pulls it from DP, then sends it on
# WhatsApp. Pushing it back would DOUBLE the same stock inside DP.
#
#   "dealer portal pe apna stock already hai, exist kar raha hai,
#    wahi se main nikal ke deta hoon aapko"   — Harun
#
# This REVERSES section 8(a) of the original spec, which had said own-stock
# vendors get a DP account and are pushed like any other vendor. They do not.
#
# Only EXTERNAL vendors are pushed — Northend, Ess Aay, A K Motors, Karol
# Bagh and the like: the ones who send us their stock, which DP does not
# already hold.
#
# The account list above is opt-in, so an unlisted vendor is never pushed
# anyway. This is the second lock: any vendor whose name matches this list
# (whole word) is dropped even if someone adds it to a group by mistake, and
# the refusal is logged. Vendors flagged as own stock in the database, or
# matching OWN_STOCK_VENDOR_NAME, are refused too.
DEALER_PORTAL_EXCLUDE_VENDORS=Bijvasan, Bijwasan, Bijwashan, Mansarovar, Mansarover, Maansarovar, Jaipur

# Per account (replace <KEY> with the key from the list above):
#
#   DEALER_PORTAL_<KEY>_USERNAME       DP dealer login
#   DEALER_PORTAL_<KEY>_PASSWORD       DP dealer password
#   DEALER_PORTAL_<KEY>_VENDORS        which ProcureHub vendors feed it
#   DEALER_PORTAL_<KEY>_FULL_SNAPSHOT  may sold-out parts be zeroed?
#
# _VENDORS IS THE IMPORTANT ONE -- IT IS A GROUP, NOT A SINGLE VENDOR.
# ProcureHub holds `Bijvasan` and `Bijwasan` as two SEPARATE vendor rows
# (same real warehouse, two spellings). They STAY separate -- no merge, no
# rows moved, allocation untouched. But DP has ONE account for that
# warehouse, so both vendor rows are listed in one _VENDORS line and the
# delta is computed over the UNION of them. Without that, Bijvasan's push
# would zero the parts Bijwasan still stocks.
#
# Each comma-separated entry matches a vendor in either of two ways:
#   1. exact Vendor.vendor_code, case-insensitive  (NS_CT, MA_CT)
#   2. tolerant NAME match -- case-insensitive, whole word anywhere in the
#      name. So "Bijwasan" also matches "BIJWASAN HUB" and "Main Bijwasan
#      Warehouse", but NOT "Bijwasannual Traders". Identical to the rule
#      OWN_STOCK_VENDOR_NAME already uses, so a slight rename cannot
#      silently drop a vendor out of its group.
#
# FULL_SNAPSHOT defaults to FALSE and should stay false until you have
# confirmed that vendor sends a COMPLETE daily list. False = sold-out parts
# are still detected and logged, but NOT zeroed -- so a vendor who sends
# only one brand one day cannot have their real DP stock wiped.
#
# Example -- the two own-stock warehouses plus two external vendors:
#
#   DEALER_PORTAL_ACCOUNTS=BIJWASAN,MANSAROVAR,MARUTI,FORD
#
#   DEALER_PORTAL_BIJWASAN_USERNAME=
#   DEALER_PORTAL_BIJWASAN_PASSWORD=
#   DEALER_PORTAL_BIJWASAN_VENDORS=Bijvasan,Bijwasan
#   DEALER_PORTAL_BIJWASAN_FULL_SNAPSHOT=true
#
#   DEALER_PORTAL_MANSAROVAR_USERNAME=
#   DEALER_PORTAL_MANSAROVAR_PASSWORD=
#   DEALER_PORTAL_MANSAROVAR_VENDORS=Mansarovar,Mansarover
#   DEALER_PORTAL_MANSAROVAR_FULL_SNAPSHOT=true
#
#   DEALER_PORTAL_MARUTI_USERNAME=
#   DEALER_PORTAL_MARUTI_PASSWORD=
#   DEALER_PORTAL_MARUTI_VENDORS=Maruti
#   DEALER_PORTAL_MARUTI_FULL_SNAPSHOT=false
#
#   DEALER_PORTAL_FORD_USERNAME=
#   DEALER_PORTAL_FORD_PASSWORD=
#   DEALER_PORTAL_FORD_VENDORS=Ford
#   DEALER_PORTAL_FORD_FULL_SNAPSHOT=false
#
# Optional per account:
#   DEALER_PORTAL_<KEY>_TOKEN      a permanent / refresh token. When set, NO
#                                  login call is made at all and USERNAME /
#                                  PASSWORD are not needed -- no 8-hour
#                                  expiry, no device_id, no 409
#                                  SESSION_ALREADY_ACTIVE. Switch to this
#                                  the moment the long-lived credentials
#                                  exist; nothing else changes.
#   DEALER_PORTAL_<KEY>_DEVICE_ID  device id for the interactive login
#                                  (default procurehub-<key>). Reusing one
#                                  stable id per account is what avoids the
#                                  409 collision.
#   DEALER_PORTAL_<KEY>_TAT_DAYS   overrides DEALER_PORTAL_TAT_DAYS below
#   DEALER_PORTAL_<KEY>_ENABLED    false parks one account without deleting
#                                  its block

# ---------------------------------------------------------------------
# Global defaults
# ---------------------------------------------------------------------
# ProcureHub does not track a per-row TAT, so this is sent for every row.
DEALER_PORTAL_TAT_DAYS=3

# How a part appearing twice is collapsed before the CSV is written. DP
# itself SUMS duplicates, which silently inflates stock if our parser emits
# a part twice -- we never inherit that. "max" (default) takes the largest
# single stated availability, so a duplicate can never inflate. "sum" and
# "first" are available if you decide otherwise.
DEALER_PORTAL_DUPLICATE_STRATEGY=max

DEALER_PORTAL_TIMEOUT_SECONDS=60

# Retry sweep for pushes left in FAILED (a DP outage, a timeout, an auth
# failure). Safe to repeat -- DP's absolute-replace semantics mean the same
# CSV sent twice cannot double-count. 0 disables the sweep.
DEALER_PORTAL_RETRY_INTERVAL_MINUTES=30
DEALER_PORTAL_RETRY_MAX_ATTEMPTS=5

# NOTE -- AFTER A DATA PURGE. Purging vendor data deletes every
# InventoryImport row, so there is no previous snapshot and the next push
# zeroes nothing: DP silently keeps stale stock. Re-import the current
# vendor files, then run:
#     python -m backend.scripts.dealer_portal_resync --all --full
# Use --dry-run first to see exactly what would be sent.


# =====================================================================
# ALLOCATION: CURRENT STOCK ONLY
# =====================================================================
# Founder's rule (3 Sep 2026): "Allocation should only be done by the
# CURRENT stock. The same with update on the spreadsheet."
#
# Before this, allocation used each vendor's LATEST file whatever its age --
# a vendor who last uploaded five days ago was still being allocated from,
# so the engine promised stock nobody had confirmed that day.
#
# Now a vendor only counts when their active import is fresh, using the SAME
# boundary the Google Sheet's daily reset uses (GOOGLE_SHEETS_DAILY_RESET_TIME
# below), so allocation and the Sheet always agree:
#
#   after 09:15 IST  -> only files uploaded since IST midnight TODAY count
#   before 09:15 IST -> yesterday's files still count, exactly as the Sheet
#                       still shows yesterday's tabs (the reset has not run).
#                       Without this every order before ~10am would find ZERO
#                       stock, since the morning stock request only goes out
#                       at 09:30.
#
# A five-day-old file is never current either way.
#
# IMPORTANT: allocation still reads STOCK FROM THE DATABASE, never from the
# Google Sheet -- only the freshness RULE is shared.
#
# false = previous behaviour (every vendor's latest file counts, however
# old). Kept as an escape hatch: on a day when nobody has uploaded and an
# order must still be allocated, turn this off without a deploy.
ALLOCATION_CURRENT_STOCK_ONLY=true


# =====================================================================
# SALES TEAM: STOCK CHECK -> CONFIRM -> PURCHASE TEAM
# =====================================================================
# Founder, 3 Sep 2026. Register the sales team over WhatsApp ("register
# sales", then the list). Those numbers can then ask about stock and get an
# instant answer -- availability and quantity ONLY, never the vendor or the
# price.
#
#   Amit:  41341M68P00 x 4, 75700TF0901 x 2
#   Bot:   [A3] 41341M68P00 AVAILABLE 6 pcs / 75700TF0901 AVAILABLE 9 pcs
#          Reply "confirm <customer name>" to order.
#   Amit:  confirm Karol Bagh
#   Bot:   Order confirmed for Karol Bagh. The purchase team has the list.
#
# The allocation workbook (which vendor to buy each part from) goes to the
# PURCHASE team only -- the sales member is told the order is placed and
# nothing more. Sales moves fast; purchasing decides where to buy.
#
# Nothing is ordered until the member confirms: a stock check is a question,
# and auto-confirming would reserve stock nobody asked for. On confirm the
# stock is RE-CHECKED, because another order may have taken it meanwhile --
# the member is told plainly if it moved rather than being sold air.

# How long a quote's QUANTITIES stay trustworthy (minutes). Past this the
# parts are NOT thrown away: on "confirm" the bot re-checks the stock, shows
# what is available RIGHT NOW, and asks the member to confirm those figures
# instead -- so they never retype the parts.
#
#   Amit (2.5h later):  confirm Karol Bagh
#   Bot:  [I21] That check was 2.5 hours old — here is the stock RIGHT NOW:
#         75700TF0901 — AVAILABLE, 9 pcs
#         Confirm this order for Karol Bagh? Reply "yes".
#   Amit: yes   -> order placed
#
# 0 = quantities never go stale (not advised).
WHATSAPP_SALES_QUOTE_TTL_MINUTES=60

# The HARD ceiling (hours). Beyond this even the re-check is not offered and
# the member is asked to send the parts again -- a day-old question is
# probably not the order they still want. 0 = no ceiling.
WHATSAPP_SALES_QUOTE_MAX_AGE_HOURS=24

# OPTIONAL single reminder for a quote still unconfirmed after N minutes --
# asked ONCE, never repeated. 0 (default) disables it: with ten people asking
# all day, unprompted nudges become noise the team learns to ignore. Try 15
# or 30 if members forget to confirm.
WHATSAPP_SALES_NUDGE_MINUTES=0

# "Same customer as last time?" — after a member confirms an order, the bot
# offers that customer back on their next bare "confirm", so they answer with
# one word instead of retyping the name.
#
# ALWAYS OFFERED, NEVER APPLIED SILENTLY. One sales person serves MANY
# customers, so quietly reusing the last name would file the order against
# the wrong one. The bot shows the name and waits for "yes"; typing
# "confirm <other customer>" overrides it at any time.
#
# This setting only limits how long the suggestion stays on offer (hours) --
# it stops the bot proposing yesterday's customer for today's order.
# 0 = never suggest, always ask for the name.
WHATSAPP_SALES_CUSTOMER_MEMORY_HOURS=12
