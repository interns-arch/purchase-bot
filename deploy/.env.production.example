# EC2 production settings for docker compose. Copy to `.env` in the REPO
# ROOT on the server (Compose reads that file automatically):
#
#     cp deploy/.env.production.example .env
#     nano .env          # set JWT_SECRET_KEY, POSTGRES_PASSWORD
#     chmod 600 .env
#
# NEVER commit this filled-in file. `.env` and `*.env` are already
# git-ignored; keep it that way.
#
# Application settings (WhatsApp tokens, AI keys, Gmail credentials) live in
# backend/.env, which the backend container reads. Copy that file to the
# server separately over scp -- never through GitHub.

# --- Ports (all bound to 127.0.0.1 by deploy/docker-compose.prod.yml) -----
# Nginx on the host is the only PUBLIC listener, on :80/:443. These two are
# reachable from the EC2 box itself only, so they are NOT opened in the
# Security Group.
BACKEND_PORT=4008
FRONTEND_PORT=4009

# --- Database (container, never Neon) ------------------------------------
POSTGRES_USER=procurehub
# CHANGE THIS. Generate one: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=procurehub

# DATABASE_URL is intentionally NOT set here.
# docker-compose.yml derives it as:
#     postgresql://<user>:<password>@db:5432/<db>
# i.e. the container over the compose network. Setting it to a Neon URL
# would point production at Neon -- do not.

# --- Auth ----------------------------------------------------------------
# MUST be changed and kept stable: rotating it logs everyone out.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_64_HEX_CHARS
JWT_EXPIRE_MINUTES=480

# Bootstrap login. IGNORED once any user exists -- and the restored
# production database already contains its users, so after the restore you
# log in with your existing production credentials, not these.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ONLY_USED_IF_NO_USERS_EXIST

# --- Frontend ------------------------------------------------------------
# "/" makes the browser call the API on the same origin it loaded from, so
# the public IP/domain is NOT baked into the bundle: changing the IP, adding
# a domain, or moving to HTTPS needs no frontend rebuild.
VITE_API_BASE_URL=/

# Browser origins the API accepts. With the same-origin setup above the
# frontend does not strictly need an entry here, but list the public
# address so direct API tools and any future subdomain keep working.
# Use the real values, e.g.:
#   CORS_ORIGINS=http://13.234.56.78,https://procurehub.example.com
CORS_ORIGINS=http://EC2_PUBLIC_IP

# --- Integrations: keep OFF until the deployment is verified -------------
# These use the SAME credentials as the existing Render deployment. Enabling
# Gmail here makes two instances race for the same unread mail; enabling
# WhatsApp sends real messages to real vendors. Turn them on only after you
# have decided which instance owns them.
WHATSAPP_ENABLED=false
ENABLE_WHATSAPP_AUTOMATION=false
GMAIL_ENABLED=false
ENABLE_EMAIL_AUTOMATION=false
ENABLE_GOOGLE_SHEETS_SYNC=false
