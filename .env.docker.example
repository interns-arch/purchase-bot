# Optional settings for `docker compose`. Copy to `.env` in the REPO ROOT
# (Compose reads that file automatically) and change only what you need --
# every value below already has a working default.
#
# This file is for the COMPOSE SETUP itself. Application configuration
# (WhatsApp tokens, AI keys, Gmail credentials) still lives in
# backend/.env, which the backend container reads automatically.

# --- Ports on your machine ------------------------------------------------
FRONTEND_PORT=5173
BACKEND_PORT=8000
# Deliberately not 5432, so it cannot clash with a Postgres already
# installed on the host.
POSTGRES_PORT=55432

# --- Local database -------------------------------------------------------
POSTGRES_USER=procurehub
POSTGRES_PASSWORD=procurehub
POSTGRES_DB=procurehub

# Leave DATABASE_URL UNSET to use the `db` container above -- that is the
# safe default. Set it only to point the containers at a real database, and
# be aware that means writing to live data:
# DATABASE_URL=postgresql://user:password@host/dbname

# --- First login ----------------------------------------------------------
# Only used while the database has zero user accounts.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=procurehub123

# Change for anything beyond your own machine; changing it later logs
# everyone out. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-change-me

# --- Integrations: OFF unless you deliberately turn them on ---------------
# A container on your laptop uses the SAME credentials as production. Enable
# Gmail here and two instances race for the same unread mail; enable WhatsApp
# and the bot sends real messages to real vendors. Turn one on only while you
# are actively testing it.
WHATSAPP_ENABLED=false
GMAIL_ENABLED=false
ENABLE_GOOGLE_SHEETS_SYNC=false

# --- Frontend -------------------------------------------------------------
# Where the BROWSER reaches the API. Baked in at build time by Vite, so a
# change needs `docker compose build frontend`, not just a restart.
VITE_API_BASE_URL=http://localhost:8000

# Origins the API accepts browser calls from (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
